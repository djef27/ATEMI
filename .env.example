# ===========================================
# Supabase (REQUIRED)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ===========================================
# App (REQUIRED)
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Atémi

# ===========================================
# WhatsApp — Admin business number (REQUIRED for notifications)
# ===========================================
NEXT_PUBLIC_ADMIN_WHATSAPP=+22900000000

# ===========================================
# WhatsApp API — Meta Cloud API
# CONFIGURATION REQUIRED WHEN WHATSAPP_PROVIDER=meta
#
# Providers: mock (dev), meta (Meta WhatsApp Cloud API)
#
# To configure:
# 1. Create a Meta Business account at https://business.facebook.com
# 2. Create an app at https://developers.facebook.com with WhatsApp product
# 3. Get a Phone Number ID from WhatsApp > Getting Started
# 4. Generate a System User access token with whatsapp_business_messaging permission
# 5. Set WHATSAPP_PROVIDER=meta, WHATSAPP_API_URL, WHATSAPP_API_TOKEN
# 6. Webhook: set WHATSAPP_VERIFY_TOKEN (random string), WHATSAPP_APP_SECRET
#    (from Meta app dashboard), then subscribe at
#    https://developers.facebook.com → Your App → WhatsApp → Configuration →
#    Webhook → Callback URL = https://<your-domain>/api/whatsapp/webhook,
#    Verify token = WHATSAPP_VERIFY_TOKEN, subscribe to `messages`
#    (including message:deliveries and message:failed statuses).
#
# IMPORTANT: WHATSAPP_API_TOKEN / WHATSAPP_APP_SECRET / WHATSAPP_VERIFY_TOKEN
# are SERVER-SIDE ONLY. Never use NEXT_PUBLIC_ prefix.
# ===========================================
WHATSAPP_PROVIDER=mock
WHATSAPP_API_URL=https://graph.facebook.com/v25.0/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_API_TOKEN=your_meta_access_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_VERIFY_TOKEN=your_random_verify_token_here

# ===========================================
# Cron (OPTIONAL) — protects /api/notifications/dispatch
# ===========================================
CRON_SECRET=

# ===========================================
# Payment Provider (REQUIRED)
# Providers: mock (dev/test), cinetpay, fedapay, kkiapay
#
# DEVELOPMENT: PAYMENT_PROVIDER=mock (no real transactions)
# PRODUCTION:  PAYMENT_PROVIDER=kkiapay (or cinetpay/fedapay)
# ===========================================
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=

# CinetPay (required when PAYMENT_PROVIDER=cinetpay)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
# Comma-separated methods enabled in the CinetPay merchant account.
# Leave empty until each method is confirmed in the merchant dashboard.
CINETPAY_ENABLED_METHODS_BJ=
CINETPAY_ENABLED_METHODS_CI=
CINETPAY_ENABLED_METHODS_TG=

# KKiaPay (required when PAYMENT_PROVIDER=kkiapay)
# In the dashboard, create a Sandbox or Live key set (public/private/secret).
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
# Set true only with Sandbox credentials; use false for Live credentials.
KKIAPAY_SANDBOX=true

# ===========================================
# Rate Limiting — Upstash Redis (RECOMMENDED FOR PRODUCTION)
#
# REQUIRED in production for financial endpoints (order creation,
# payment confirmation). Without these, financial endpoints are
# blocked in production (fail-closed security).
#
# DEVELOPMENT: Not required (falls back to in-memory)
# PRODUCTION:  Set from Upstash dashboard
# ===========================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===========================================
# Email — Brevo (REQUIRED for transactional emails)
# Sans cette clé, les emails sont loggés en console (mode dev).
# ===========================================
BREVO_API_KEY=

# ===========================================
# General
# ===========================================
NODE_ENV=development

# ===========================================
# ATEMI AI CONTENT ENGINE
# ===========================================

# -------------------------------------------
# OpenAI (REQUIRED for text + image generation)
# Get key at: https://platform.openai.com/api-keys
# -------------------------------------------
OPENAI_API_KEY=

# -------------------------------------------
# ElevenLabs (OPTIONAL for voice generation)
# Get key at: https://elevenlabs.io/app/settings/api-keys
# -------------------------------------------
ELEVENLABS_API_KEY=

# -------------------------------------------
# TikTok API (OPTIONAL for publishing)
# Get keys at: https://developers.tiktok.com/
# -------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# -------------------------------------------
# Facebook/Instagram API (OPTIONAL for publishing)
# Get keys at: https://developers.facebook.com/
# -------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# -------------------------------------------
# Content Engine Settings
# -------------------------------------------
# Content Engine is DISABLED by default (fail-closed): the AI providers and the
# social publishing integrations are not implemented yet, so enabling it would
# either incur real OpenAI costs or report fake "published" results. Set to
# "true" ONLY once providers + platform adapters are implemented and verified.
CONTENT_ENGINE_ENABLED=false
CONTENT_ENGINE_STORAGE_BUCKET=content-engine
